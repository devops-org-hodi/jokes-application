pipeline{
    agent any
    environment{
        DOCKER_REPO="hothaifaz11/jokes-api"
        DOCKER_IMAGE="hothaifaz11/jokes-api:v$BUILD_NUMBER"
        CONTAINER_NAME="$JOB_NAME"
        // APPLCIATION_PORT
        // TEST_REPO
        // TEST_DIR
        // DEPLOYMENT_REPO
        // DEPLOYMNET_DIR

    }
    stages{
        stage("Build"){
           steps{
                echo "======= building docker image ========"
                sh "docker build -t $DOCKER_IMAGE ."
            }
            post{
                success{
                    echo "------- verfy image tag ----------"
                    sh "docker image ls | grep -i $DOCKER_REPO"
                }
            }
           
        }
        stage("prepare for testing"){
            steps{
                sh """docker run \
                      --name $CONTAINER_NAME \
                      -p 5000:5000 \
                      $DOCKER_IMAGE
                      """
            }
        }
    }
    post{
        always{
            sh "docker rm -f $CONTAINER_NAME"
            cleanWs()
            sh "docker rmi $DOCKER_IMAGE"
        }
        success{
            echo "========pipeline executed successfully ========"
        }
        failure{
            echo "========pipeline execution failed========"
        }
    }
}

